# Opcionais — sem elas, o app roda 100% local (sem sync com a nuvem).
# Settings > API no dashboard do Supabase. A anon/publishable key é segura de
# expor no client (o acesso real é controlado por RLS no banco).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
